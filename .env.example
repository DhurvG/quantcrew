# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your-groq-key
ANTHROPIC_API_KEY=your-anthropic-key

# groq   = free tier (gpt-oss-20b agents, gpt-oss-120b Critic) for development and testing
# claude = paid Claude Haiku 5.5 for every role, for the backtest and demo day
QUANTCREW_PROFILE=groq

QUANTCREW_MAX_DEBATE_ROUNDS=1
QUANTCREW_MAX_TOOL_STEPS=3
QUANTCREW_MAX_CONCURRENCY=2
# Optional per-role override of the profile, e.g.:
# QUANTCREW_CRITIC_MODEL=anthropic:claude-sonnet-5-5
